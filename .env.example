ANTHROPIC_API_KEY=sk-ant-...
ABUSEIPDB_API_KEY=...
VIRUSTOTAL_API_KEY=...
URLSCAN_API_KEY=...
# Optional — model selection. MODEL is the strong/authoritative model;
# TIER_CHEAP_MODEL is the cheap first-pass model used by --tiered.
# MODEL=claude-sonnet-5
# TIER_CHEAP_MODEL=claude-haiku-4-5
# Optional — Elastic SIEM integration (--from-elastic)
# ELASTIC_URL=https://elastic.internal:9200
# ELASTIC_API_KEY=...
# ELASTIC_ALERTS_INDEX=.alerts-security.alerts-default
# ELASTIC_RESULTS_INDEX=soc-copilot-investigations
# ELASTIC_EVENTS_INDEX=soc-events-demo   # raw telemetry for search_internal_logs
# Optional — TheHive case management (--case)
# THEHIVE_URL=https://thehive.internal:9000
# THEHIVE_API_KEY=...
# THEHIVE_ORGANISATION=soc-team
# Optional — escalation webhook for --watch --notify (Slack/Mattermost/generic)
# WEBHOOK_URL=https://hooks.slack.com/services/...
# Optional — how the CLI narrates on stderr. LOG_FORMAT=json emits one
# {"ts","level","msg","alert_id"} object per line for a log shipper;
# the default "text" is the same prose as before. LOG_LEVEL default INFO
# (DEBUG | INFO | WARNING | ERROR).
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# Docker only — match the container to your host user so the bind-mounted
# data/ stays writable on both sides (docker-compose.yml interpolates
# these; fill with `id -u` / `id -g`):
# HOST_UID=1000
# HOST_GID=1000
