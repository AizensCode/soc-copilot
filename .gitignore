# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Conventionally files to ignore, .env file, logs, caches and any sample alerts related to real life scenarios.
.env
*.log
.pytest_cache/
data/sample_alerts/*.real.json
# Runtime case history — holds real investigation records, keep out of git
data/history/
# Default filename for the opt-in `--debug` dump (nothing is written
# without the flag; the agentic final-turn file is no longer produced)
last_run_debug.json

# Calibration reports are point-in-time measurement output (live model),
# not committed test input like the cassette. Snapshot deliberately via --out.
data/evals/calibration/
